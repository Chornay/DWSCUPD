const MODES = {
   MAIN: 0,
   ADD_COUPON: 10
}

export default class UtilTop extends Component {

   constructor() {
      super();
      this.state = {
         isComponentInitialized: false,
         mode: MODES.MAIN,
         selCust: null,
         custName: null,
      };
      this.custRec = null
   }
   componentDidMount() {
      this.setState({ isComponentInitialized: true })
   }

   render() {

      if (!this.state.isComponentInitialized) return null

      switch (this.state.mode) {

         case MODES.MAIN:
            return (

               <CdsScreen>
                  <GCHeader
                     back={() => this.props.navigation.goBack()}
                     titleText='Customer Utilities'
                  />
                  <View style={{ flex: 1, marginHorizontal: GC_STD_MARGIN }}>
                     <UtilInput label='Customer' field={this.state.selCust}
                        onEndEditing={async (val) => {
                           this.setState({ selCust: val })
                           this.custRec = await dwdbfsCustGet(val)
                           console.log(this.custRec, !this.custRec)
                           if (!this.custRec) {
                              this.setState({ custName: null })
                              console.log('customer not found')
                              Toast.show({
                                 text: "Customer not found",
                                 buttonText: 'okay',
                                 duration: 5000,
                                 type: 'danger'
                              })
                           }
                        }} />
                     <View style={{ height: 10 }} />
                     <Text>{this.state.custName}</Text>
                     <View style={{ height: 30 }} />
                     {this.custRec && <View>
                        <UtilChoice
                           onPress={() => { this.setState({ mode: MODES.ADD_COUPON }) }}
                           text="Add Coupon"
                        />
                     </View>}
                  </View>
               </CdsScreen>
            )
            break;

            case MODES.ADD_COUPON:
               return (
                  <AddCoupon cust={this.custRec} 
                     onBack={() => { this.setState({ mode: MODES.MAIN }) }} />
               )
               break;
   
         default:
            return null
            break;

      }//end switch
   } //end render

} //end UtilCust


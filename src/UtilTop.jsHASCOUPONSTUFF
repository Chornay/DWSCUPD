//prop cust
//prop onBack()
class AddCoupon extends Component {
   constructor(props) {
      super(props);
      this.state = {
         coupon: null
      };
   }
   render() {
      return (
         <CdsScreen>
            <GCHeader back={this.props.onBack}
               titleText={'Add Coupon ' + this.props.cust.id}
            />


            <View style={{ flex: 1 }}>
               <TextInput
                  value={this.state.priceList}
                  multiline={true}
                  onChangeText={input => this.setState({ coupon: input })}
                  placeholder={"Enter Coupon"}
                  style={styles.input}
               />
               <View style={{ marginTop: 20 }}>
                  <Button onPress={async () => {
                     let foo = eval('new Object (' + this.state.coupon + ')')
                     foo.shopId = this.props.shopId
                     try {
                        await firestore().collection('PriceLists').doc(this.props.shopId).set({
                           ...foo
                        })
                        Toast.show({
                           text: 'update done',
                           buttonText: 'okay',
                           duration: 5000,
                           type: 'success'
                        })
                     }
                     catch (error) {
                        // console.log(error)
                        Toast.show({
                           text: error.message,
                           buttonText: 'okay',
                           duration: 5000,
                           type: 'danger'
                        })

                     }
                  }} title="Add Coupon" />
               </View>
            </View>
         </CdsScreen>
      );
   }
}



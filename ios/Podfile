require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/react-native/node_modules/@react-native-community/cli-platform-ios/native_modules'

permissions_path = '../node_modules/react-native-permissions/ios'
platform :ios, '13.0'

target 'DW' do
  config = use_native_modules!

  pod 'Permission-LocationAccuracy', :path => "#{permissions_path}/LocationAccuracy"
  pod 'RNPermissions', :path => '../node_modules/react-native-permissions'
  pod 'RNVectorIcons', :path => '../node_modules/react-native-vector-icons'
  pod 'GoogleSignIn'
  pod 'react-native-splash-screen', :path => '../node_modules/react-native-splash-screen'
  pod 'Permission-Calendars', :path => "#{permissions_path}/Calendars"
  pod 'Permission-Camera', :path => "#{permissions_path}/Camera"
  pod 'Permission-Contacts', :path => "#{permissions_path}/Contacts"
  pod 'Permission-LocationAlways', :path => "#{permissions_path}/LocationAlways"
  pod 'Permission-LocationWhenInUse', :path => "#{permissions_path}/LocationWhenInUse"
  pod 'Permission-Microphone', :path => "#{permissions_path}/Microphone"
  pod 'Permission-Notifications', :path => "#{permissions_path}/Notifications"
  pod 'Permission-PhotoLibrary', :path => "#{permissions_path}/PhotoLibrary"
  pod 'Permission-PhotoLibraryAddOnly', :path => "#{permissions_path}/PhotoLibraryAddOnly"
  pod 'Permission-Reminders', :path => "#{permissions_path}/Reminders"
  pod 'BEMCheckBox'
  pod 'RNSha256', :path => '../node_modules/react-native-sha256'
  pod 'RNGestureHandler', :path => '../node_modules/react-native-gesture-handler'
  pod 'RNSound', :path => '../node_modules/react-native-sound'
  pod 'react-native-webview', :path => '../node_modules/react-native-webview'
  pod 'RNScreens', :path => '../node_modules/react-native-screens'
  pod 'RNFBApp', :path => '../node_modules/@react-native-firebase/app'
  pod 'RNFBAuth', :path => '../node_modules/@react-native-firebase/auth'
  pod 'RNFBFirestore', :path => '../node_modules/@react-native-firebase/firestore'
  pod 'RNFBFunctions', :path => '../node_modules/@react-native-firebase/functions'
  pod 'RNFBMessaging', :path => '../node_modules/@react-native-firebase/messaging'
  pod 'RNFBStorage', :path => '../node_modules/@react-native-firebase/storage'
  pod 'RNFBRemoteConfig', :path => '../node_modules/@react-native-firebase/remote-config'
  pod 'react-native-camera', :path => '../node_modules/react-native-camera'
  pod 'RNAppleAuthentication', :path => '../node_modules/@invertase/react-native-apple-authentication'
  pod 'RNCCheckbox', :path => '../node_modules/@react-native-community/checkbox'
  pod 'RNCMaskedView', :path => '../node_modules/@react-native-community/masked-view'
  pod 'react-native-netinfo', :path => '../node_modules/@react-native-community/netinfo'
  pod 'react-native-geolocation-service', :path => '../node_modules/react-native-geolocation-service'
  pod 'react-native-device-country', :path => '../node_modules/react-native-device-country'
  pod 'RNDeviceInfo', :path => '../node_modules/react-native-device-info'
  pod 'RNLocalize', :path => '../node_modules/react-native-localize'
  pod 'RNReanimated', :path => '../node_modules/react-native-reanimated'
  pod 'react-native-safe-area-context', :path => '../node_modules/react-native-safe-area-context'
  pod 'Google-Maps-iOS-Utils', :git => 'https://github.com/Simon-TechForm/google-maps-ios-utils.git', :branch => 'feat/support-apple-silicon'
  rn_maps_path = '../node_modules/react-native-maps'
  pod 'react-native-google-maps', :path => rn_maps_path
  pod 'react-native-maps', :path => rn_maps_path
  pod 'RNCAsyncStorage', :path => '../node_modules/@react-native-async-storage/async-storage'
  pod 'RNQrGenerator', :path => '../node_modules/rn-qr-generator'
  # pod 'RNThermalReceiptPrinterImageQr', :path => '../node_modules/react-native-thermal-receipt-printer-image-qr'

  use_react_native!(:path => config["reactNativePath"])

  pod 'react-native-html-to-pdf', :path => '../node_modules/react-native-html-to-pdf'

  target 'DWTests' do
    inherit! :complete
  end
end

post_install do |installer|
  react_native_post_install(installer)
  __apply_Xcode_12_5_M1_post_install_workaround(installer)
  # Fix: ABSL_CONST_INIT breaks FirebaseFirestore 8.8.0 on new Xcode.
  firestore_settings = "#{installer.sandbox.root}/FirebaseFirestore/Firestore/Source/API/FIRFirestoreSettings.mm"
  if File.exist?(firestore_settings)
    File.chmod(0644, firestore_settings)
    File.write(firestore_settings, File.read(firestore_settings).gsub('ABSL_CONST_INIT ', ''))
  end

  # Fix: RCT-Folly clockid_t redefinition on new iOS SDKs (Time.h).
  folly_time_h = "#{installer.sandbox.root}/RCT-Folly/folly/portability/Time.h"
  if File.exist?(folly_time_h)
    File.chmod(0644, folly_time_h)
    src = File.read(folly_time_h)
    patched = src.gsub(/typedef\s+uint8_t\s+clockid_t\s*;/, '/* typedef uint8_t clockid_t; (SDK defines it) */')
    File.write(folly_time_h, patched) if patched != src
  end

  # Fix: FBReactNativeSpec "Generate Specs" fails because `tee` gets an empty output file.
  installer.pods_project.targets.each do |t|
    next unless t.name == 'FBReactNativeSpec'
    t.build_phases.each do |phase|
      next unless phase.respond_to?(:shell_script) && phase.name.to_s.include?('Generate Specs')
      phase.shell_script = phase.shell_script.gsub(/\|\s*tee\s+[^\n]*/, '')
    end
  end

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings["EXCLUDED_ARCHS[sdk=iphonesimulator*]"] = "arm64"
      config.build_settings['ARCHS'] = '$(ARCHS_STANDARD)'
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS'] = 'NO'
      config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
      config.build_settings['SWIFT_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
      config.build_settings['SWIFT_INSTALL_OBJC_HEADER'] = 'NO'
      config.build_settings['OTHER_LDFLAGS'] = '$(inherited) -lswift_Concurrency -lswift_StringProcessing'
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'

      # Fix: std::unary_function removed from new libc++ (Boost / RCT-Folly).
      defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
      defs = [defs] if defs.is_a?(String)
      flag = '_LIBCPP_ENABLE_CXX17_REMOVED_UNARY_BINARY_FUNCTION=1'
      defs << flag unless defs.include?(flag)
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
    end

    if target.name == 'BoringSSL-GRPC'
      target.build_configurations.each do |config|
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = nil
      end
      target.source_build_phase.files.each do |file|
        if file.settings && file.settings['COMPILER_FLAGS']
          flags = file.settings['COMPILER_FLAGS'].split
          flags.reject! { |flag| flag.start_with?('-GCC_WARN') || flag == '-G' }
          file.settings['COMPILER_FLAGS'] = flags.join(' ')
        end
      end
    end

    if target.name == 'react-native-geolocation-service'
      target.build_configurations.each do |config|
        config.build_settings['SWIFT_VERSION'] = '5.0'
        config.build_settings['OTHER_SWIFT_FLAGS'] = '$(inherited) -Xfrontend -disable-reflection-metadata'
        config.build_settings['SWIFT_DEPLOYMENT_TARGET'] = '13.0'
        config.build_settings['SWIFT_STRICT_CONCURRENCY'] = 'minimal'
      end
    end
  end
end
